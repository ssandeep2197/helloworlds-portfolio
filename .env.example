# Server-side only — used by the Netlify function (netlify/functions/contact.ts).
# These do NOT have a VITE_ prefix on purpose: they must never reach the browser bundle.
# In production: set them in Netlify → Site settings → Environment variables.
# Locally: run `netlify dev` (Netlify CLI) so the function picks them up from this file.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=s.sandeep2197@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_TO=s.sandeep2197@gmail.com
